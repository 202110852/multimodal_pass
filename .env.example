# 공공데이터포털 (data.go.kr) — 한국관광공사 국문 관광정보 KorService2
# 마이페이지 > 인증키 발급현황에서 Decoding 키를 그대로 붙여넣으세요.

TOUR_API_SERVICE_KEY=

TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=VisitKoreaLocal

# 카카오모빌리티 길찾기 API (developers.kakaomobility.com)
# 카카오디벨로퍼스 > 앱 > 플랫폼 키에서 REST API 키를 붙여넣으세요.

KAKAO_MOBILITY_REST_API_KEY=

KAKAO_MOBILITY_NAVI_BASE_URL=https://apis-navi.kakaomobility.com

# SK open API (openapi.sk.com) — TMAP / Puzzle 등
# 마이페이지 > 앱 > 앱키(appKey) 탭에서 확인 후 붙여넣으세요.

SK_OPENAPI_APP_KEY=

SK_OPENAPI_BASE_URL=https://apis.openapi.sk.com

# 기상청 API허브 (apihub.kma.go.kr) — 마이페이지 인증키(authKey)
# ※ 공공데이터포털(data.go.kr) ServiceKey와 별개입니다.

KMA_APIHUB_AUTH_KEY=

KMA_APIHUB_BASE_URL=https://apihub.kma.go.kr

# 특보현황 조회 (현재 발효 중인 특보)
# fe=f 발표기준 / e=발효기준, tm=비우면 현재, authKey는 코드에서 붙임
KMA_APIHUB_WRN_NOW_URL=https://apihub.kma.go.kr/api/typ01/url/wrn_now_data.php

# 공공데이터포털 기상청 REST (apis.data.go.kr/1360000/...) — ServiceKey
# 관광공사와 같은 포털 계정이면 TOUR_API_SERVICE_KEY와 동일할 수 있음.

KMA_API_SERVICE_KEY=

# 비짓제주 관광정보 OPEN API (api.visitjeju.net)
# https://www.visitjeju.net/kr/visitjejuapi 에서 발급. 요청 쿼리: apiKey

VISITJEJU_OPENAPI_API_KEY=

VISITJEJU_OPENAPI_BASE_URL=https://api.visitjeju.net

# 공공데이터포털 — 교통약자 이동지원 현황 실시간 정보 (tsdo_v2)
# https://www.data.go.kr/data/15140825/openapi.do 활용신청 후 Decoding 키
# 키 확인: https://www.data.go.kr/iim/api/selectAPIAcountView.do

TSDO_API_SERVICE_KEY=

TSDO_API_BASE_URL=https://apis.data.go.kr/B551982/tsdo_v2

# 제주특별자치도 교통정보센터 Open API (api.jejuits.go.kr)
# https://www.jejuits.go.kr/open_api/open_apiView.do 승인 후 발급 code
# 요청 쿼리: code=

JEJU_CITS_API_CODE=

JEJU_ITS_API_CODE=

JEJU_ITS_BASE_URL=http://api.jejuits.go.kr/api

# MariaDB (datagrip-migration/run_load.sh · load.py)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DATABASE=visitkorea

# 공공데이터포털 — 제주시 공중화장실 조회 서비스
# https://www.data.go.kr/data/15109235/openapi.do 활용신청 후 Decoding 키
# (같은 포털 계정이라도 이 데이터셋에 신청돼 있어야 한다. 비우면 TOUR_API_SERVICE_KEY 재사용)

JEJUSI_TOILET_API_SERVICE_KEY=

JEJUSI_TOILET_API_BASE_URL=https://apis.data.go.kr/6510000/publicToiletService

# 공공데이터포털 — 공영 물품보관함 현황 실시간 (psl_v2)
# https://www.data.go.kr/data/15142469/openapi.do 활용신청 후 Decoding 키

PSL_API_SERVICE_KEY=

PSL_API_BASE_URL=https://apis.data.go.kr/B551982/psl_v2

# 공공데이터포털 — 국토교통부_(TAGO)_공유 퍼스널모빌리티정보 (PersonalMobilityInfo)
# https://www.data.go.kr/data/15117668/openapi.do 활용신청 후 Decoding 키

PM_API_SERVICE_KEY=

PM_API_BASE_URL=https://apis.data.go.kr/1613000/PersonalMobilityInfo
