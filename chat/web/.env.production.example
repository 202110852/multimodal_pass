# 프론트 프로덕션 빌드용. 값이 번들에 그대로 박히므로 비밀을 넣지 말 것.
# 실제 파일(.env.production)은 gitignore 대상 — 배포 머신에서 직접 만든다.

VITE_MASTRA_URL=https://api.stan.lkim.me

# 루트 .env 의 API_KEYS 중 web_* 키. 공개값이다 (소스보기로 보임).
VITE_API_KEY=

# 메인 지도(카카오맵 JS SDK) JavaScript 키. 공개값 — 카카오 콘솔 Web 플랫폼에 배포 도메인 등록 필요.
VITE_KAKAO_APP_KEY=
