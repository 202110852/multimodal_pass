# 클론 후 이 파일을 .env.local 로 복사하고 키를 채운다.
#   cp .env.local.example .env.local
#
# VITE_API_KEY — api.stan.lkim.me 호출용 키.
#   배포된 프론트 번들에 이미 들어 있는 공개값이라 비밀은 아니지만,
#   교체를 쉽게 하려고 저장소에는 두지 않는다. 팀에 요청해서 받는다.
VITE_API_KEY=

# 기본 프록시는 배포 챗봇 API (api.stan.lkim.me).
# 로컬 Mastra 를 쓸 때만 셸에서 지정한다 (이 파일의 VITE_ 변수가 아님):
#   MASTRA_URL=http://127.0.0.1:4111 npm run dev
#   cd chat && npm run dev:all
