# ── 로컬 개발 (기본) ──────────────────────────────────────────
# Postgres / 원격 stan DB 없이 기동한다.
# PG_URL·PGUSER 가 없고 LOCAL_NO_DB 가 켜져 있으면 도메인 DB 는 off.
# 에이전트 메모리는 로컬 LibSQL (file:./.mastra/local-memory.db) 에 둔다.
#
#   cd chat && npm install && npm run dev:all
#
# LOCAL_NO_DB=1          # PG 값이 있어도 강제 DB off (선택)
# MASTRA_LIBSQL_URL=file:./.mastra/local-memory.db

# ── 도메인 DB (추후 Supabase) ─────────────────────────────────
# 지금은 비워 둔다. Supabase Postgres 연동 시 connection string 또는 PG_* 를 채운다.
# PG_URL=
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=stan_jeju

# 에이전트 메모리를 Postgres 에 둘 때(도메인 DB on 일 때만). 비우면 위 접속을 그대로 쓴다.
# MASTRA_PG_SCHEMA=mastra
# MASTRA_PG_URL=

# LLM — Mindlogic FactChat API Gateway (OpenAI 호환)
# FactChat 좌측 하단 '개발자 설정' → 'API 키 생성' 에서 발급 (재조회 불가)
FACTCHAT_API_KEY=

# 아래 둘은 기본값이 있어 보통 비워 둔다
# LLM_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
# LLM_MODEL=claude-opus-5        # claude-sonnet-5 / gpt-5 도 가능

# 서버 바인딩. 로컬 기본은 127.0.0.1:4111
# MASTRA_HOST=127.0.0.1
# MASTRA_PORT=4111
# CORS_ORIGINS=

# API 키 (콤마 구분). 비어 있으면 개발에서는 통과, NODE_ENV=production 이면 500.
#   web_* 프론트용(공개) / srv_* 서버간 호출용(비공개)
# API_KEYS=

# /admin (시스템 프롬프트 편집) 접속 토큰. 브라우저 번들에 넣지 않는 비밀값이다.
# 비어 있으면 개발에서는 통과, NODE_ENV=production 이면 503.
#   openssl rand -hex 24
# ADMIN_TOKEN=

# 시스템 프롬프트 파일 (chat/ 기준 상대 경로). 기본값: prompts/system-prompt.txt
# SYSTEM_PROMPT_FILE=

# 한국관광공사 TourAPI (KorService2) — 채팅마다 요청만 보내고 결과는 쓰지 않는다.
# 저장소 루트 .env 의 값을 그대로 써도 된다 (loadEnvFiles 가 위로 찾음).
# TOUR_API_SERVICE_KEY=
# TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
# TOUR_API_MOBILE_OS=ETC
# TOUR_API_MOBILE_APP=VisitKoreaLocal

# 카카오맵 장소 검색·도보/자전거/대중교통 경로 (서버 전용 REST API 키)
# KAKAO_REST_API_KEY=
# 자동차 길찾기. 위 키가 없으면 이 키를 카카오맵에도 사용한다.
# KAKAO_MOBILITY_REST_API_KEY=
